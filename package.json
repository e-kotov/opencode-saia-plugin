{
  "name": "opencode-saia-plugin",
  "version": "0.3.0",
  "description": "Runtime SAIA (GWDG Chat AI) plugin for OpenCode 2",
  "type": "module",
  "main": "./src/server.js",
  "bin": {
    "generate-saia-config": "./src/generate-saia-config.sh",
    "copy-saia-config": "./src/copy-saia-config.sh",
    "validate-saia-config": "./src/validate-config.sh",
    "setup-saia-wizard": "./src/setup-wizard.sh"
  },
  "files": [
    "src/",
    "schema/",
    ".opencode/",
    "install.sh",
    "install.ps1",
    "LICENSE",
    "README.md",
    "FAQ.md"
  ],
  "scripts": {
    "prepare-release": "bash prepare-release.sh",
    "test": "node --import tsx --test src/*.test.mjs",
    "validate": "bash src/validate-config.sh opencode.json",
    "generate": "bash src/generate-saia-config.sh",
    "tsc": "tsc --noEmit --skipLibCheck",
    "vendor:jsonc-parser": "esbuild node_modules/jsonc-parser/lib/esm/main.js --bundle --format=esm --platform=node --legal-comments=none --banner:js=\"$(cat src/vendor/jsonc-parser.banner.txt)\" --outfile=src/vendor/jsonc-parser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/e-kotov/opencode-saia-plugin.git"
  },
  "keywords": [
    "opencode",
    "saia",
    "gwdg",
    "ai",
    "plugin",
    "models",
    "chat-ai"
  ],
  "license": "MIT",
  "author": "graphwiz-ai",
  "bugs": {
    "url": "https://github.com/e-kotov/opencode-saia-plugin/issues"
  },
  "homepage": "https://github.com/e-kotov/opencode-saia-plugin",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.16",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^20.0.0",
    "jsonc-parser": "3.3.1",
    "tsx": "4.23.12",
    "typescript": "5.8.2"
  },
  "exports": {
    ".": "./src/server.js",
    "./server": "./src/server.js",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.mjs",
    "./limits": "./src/limits-server.js",
    "./v1": "./src/saia-plugin.ts",
    "./v1/tui": "./src/saia-limits-tui.tsx"
  }
}
