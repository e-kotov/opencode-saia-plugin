{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenCode SAIA Plugin Configuration Schema",
  "description": "Schema for validating opencode.json files generated by the SAIA plugin",
  "type": "object",
  "required": ["provider", "model"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "permission": {
      "type": "object",
      "description": "Tool permission settings",
      "additionalProperties": {
        "type": "string",
        "enum": ["allow", "ask", "deny"]
      }
    },
    "formatter": {
      "type": "object",
      "description": "Formatter configuration (may be empty object)"
    },
    "model": {
      "type": "string",
      "description": "Default model identifier (e.g., 'saia/glm-5.3-flash')",
      "pattern": "^saia/.+$"
    },
    "provider": {
      "type": "object",
      "required": ["saia"],
      "properties": {
        "saia": {
          "type": "object",
          "required": ["npm", "name", "options", "models"],
          "properties": {
            "npm": {
              "type": "string",
              "enum": ["@ai-sdk/openai-compatible", "@ai-sdk/openai"]
            },
            "name": {
              "type": "string",
              "description": "Provider display name"
            },
            "options": {
              "type": "object",
              "required": ["baseURL", "apiKey"],
              "properties": {
                "baseURL": {
                  "type": "string",
                  "description": "API base URL",
                  "pattern": "^https?://.+$"
                },
                "apiKey": {
                  "type": "string",
                  "description": "API key string or env variable reference",
                  "pattern": "^.*SAIA_API_KEY.*$"
                }
              }
            },
            "models": {
              "type": "object",
              "description": "SAIA model configurations",
              "additionalProperties": {
                "$ref": "#/definitions/modelConfig"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "modelConfig": {
      "type": "object",
      "required": ["name", "options", "limit"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable model name and description"
        },
        "options": {
          "type": "object",
          "description": "Model-specific options",
          "properties": {
            "enable-tools": {
              "type": "boolean"
            },
            "enable-auto-tool-choice": {
              "type": "boolean"
            },
            "tool-call-parser": {
              "type": "string",
              "enum": ["openai", "anthropic"]
            }
          }
        },
        "limit": {
          "type": "object",
          "required": ["context", "output"],
          "properties": {
            "context": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum context window in tokens"
            },
            "output": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum output tokens"
            }
          }
        },
        "can_reason": {
          "type": "boolean",
          "description": "Whether this model supports chain-of-thought reasoning"
        },
        "attachment": {
          "type": "boolean",
          "description": "Whether this model supports image/file attachment"
        },
        "alias": {
          "type": "boolean",
          "description": "Whether this is a model group alias (not a real model)"
        },
        "metadata": {
          "type": "object",
          "description": "Additional model metadata for guidance",
          "properties": {
            "cost_per_1k_tokens": {
              "type": "number",
              "minimum": 0,
              "description": "Estimated cost per 1,000 tokens in USD"
            },
            "estimated_latency": {
              "type": "string",
              "enum": ["fast", "moderate", "slow", "very-slow"],
              "description": "Estimated response latency category"
            },
            "recommended_for": {
              "type": "array",
              "description": "Use cases this model is recommended for",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
