          "name": "Apertus 70B — Open-source instruct model",
          "options": {
            "enable-tools": true,
            "enable-auto-tool-choice": true,
            "tool-call-parser": "openai"
          },
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "metadata": {
            "cost_per_1k_tokens": 0.025,
            "estimated_latency": "moderate",
            "recommended_for": [
